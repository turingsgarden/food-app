# MongoDB
MONGO_URI=
MONGO_DB=food-app-swift

# Gemini
GEMINI_API_KEY=

# JWT
JWT_SECRET_KEY=

# Apple / Google OAuth
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Email
SENDER_EMAIL=
EMAIL_PASSWORD=

# Google Vision (OCR health reports)
GOOGLE_VISION_API_KEY=

# Langfuse observability (optional — no-op if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Environment
ENVIRONMENT=development
